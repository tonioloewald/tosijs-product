{
  "name": "tosijs-product",
  "version": "0.6.1",
  "description": "Scroll-linked animation components for tosijs",
  "source": "src/index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/module.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/module.js",
      "browser": "./dist/index.js",
      "default": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "tosi-mosaic": "./bin/tosi-mosaic.ts"
  },
  "scripts": {
    "start": "bun bin/site.ts",
    "format": "bun eslint src demo --ext .ts --fix && bun prettier --write .",
    "test": "bun test",
    "build": "bun bin/site.ts --build",
    "build:legacy": "bun dev.ts --build"
  },
  "author": "Tonio Loewald",
  "license": "Apache-2.0",
  "peerDependencies": {
    "tosijs": "^1.6.4",
    "tosijs-ui": "^1.6.19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9",
    "bun-types": "^1.3.0",
    "happy-dom": "^20.7.0",
    "marked": "^16.4.2",
    "tjs-lang": "^0.8.7",
    "typescript": "^5.9.3"
  }
}
