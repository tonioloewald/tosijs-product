{
  "name": "tosijs-product",
  "version": "0.7.0",
  "description": "Scroll-linked animation components for tosijs",
  "source": "src/index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "./dist/module.js",
  "module": "./dist/module.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    "./iife": "./dist/index.js",
    "./dist/index.js": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/module.js",
    "dist/*.d.ts",
    "bin/tosi-mosaic.ts",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "tosi-mosaic": "./bin/tosi-mosaic.ts"
  },
  "scripts": {
    "start": "bun bin/site.ts",
    "format": "bun eslint src demo --ext .ts --fix && bun prettier --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun bin/site.ts --build",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "author": "Tonio Loewald",
  "license": "Apache-2.0",
  "peerDependencies": {
    "tosijs": "^1.8.1",
    "tosijs-ui": "^1.12.7"
  },
  "peerDependenciesMeta": {
    "tosijs-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9",
    "bun-types": "^1.3.0",
    "chokidar": "^4.0.3",
    "happy-dom": "^20.7.0",
    "marked": "^16.4.2 || ^17.0.0 || ^18.0.0",
    "haltija": "^1.12.6",
    "tjs-lang": "^0.13.6",
    "tosijs-ui": "^1.12.7",
    "typescript": "^5.9.3"
  }
}
