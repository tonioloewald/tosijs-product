{
  "name": "tosijs-product",
  "version": "0.8.0",
  "description": "Scroll-linked animation components for tosijs",
  "source": "src/index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "./dist/module.js",
  "module": "./dist/module.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    "./iife": "./dist/index.js",
    "./dist/index.js": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/module.js",
    "dist/*.d.ts",
    "bin/tosi-mosaic.ts",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "tosi-mosaic": "./bin/tosi-mosaic.ts"
  },
  "scripts": {
    "start": "bun bin/site.ts",
    "format": "tosijs-format",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun bin/site.ts --build",
    "stop": "bun bin/site.ts --stop",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "format:check": "tosijs-format --check"
  },
  "author": "Tonio Loewald",
  "license": "Apache-2.0",
  "peerDependencies": {
    "tosijs": "^1.10.0",
    "tosijs-ui": "^1.14.1"
  },
  "peerDependenciesMeta": {
    "tosijs-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "bun-types": "^1.3.0",
    "chokidar": "^4.0.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "haltija": "^1.12.6",
    "happy-dom": "^21.0.4",
    "marked": "^16.4.2 || ^17.0.0 || ^18.0.0",
    "prettier": "^3.9.10",
    "tjs-lang": "^0.13.13",
    "tosijs": "^1.10.9",
    "tosijs-ui": "^1.16.32",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
